rules_version = '2';

// ============================================================================
// RH NEWS VENDE-C — Firestore Security Rules
//
// Backend protection for the moderator panel. Deploy these in the Firebase
// Console → Firestore Database → Rules (or via the Firebase CLI).
//
// Only the approved moderator e-mails (authenticated through Firebase Auth)
// can create/update/delete newsletters and read all evaluations. The public
// can read published newsletters and submit (create-only) evaluations.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Approved moderators. Update this list to add/remove panel access.
    function isModerator() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'vinicius.silva@vende-c.com',
          'lucas.izan@vende-c.com'
        ];
    }

    // ----- Newsletters ------------------------------------------------------
    // Public can read; only moderators can write.
    match /newsletters/{id} {
      allow read: if true;
      allow create, update, delete: if isModerator();
    }

    // ----- Evaluations ------------------------------------------------------
    // Public can read (for the average score) and submit a new evaluation.
    // Updates/deletes are forbidden. Moderators included via the read rule.
    match /evaluations/{id} {
      allow read: if true;
      allow create: if request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 10
        && request.resource.data.name is string
        && request.resource.data.role is string;
      allow update, delete: if false;
    }
  }
}
