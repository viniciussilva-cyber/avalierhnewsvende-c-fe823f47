rules_version = '2';

// ============================================================================
// VENDE-C Platform — Firestore Security Rules (Atualizado R&S + IA)
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Lista de moderadores do RH
    function isModerator() {
      return request.auth != null
        && request.auth.token.email in [
          'vinicius.silva@vende-c.com',
          'lucas.zan@vende-c.com'
        ];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ----- Newsletters (RH News) --------------------------------------------
    match /newsletters/{id} {
      allow read: if true;
      allow create, update, delete: if isModerator();
    }

    // ----- Evaluations (RH News) --------------------------------------------
    match /evaluations/{id} {
      allow read: if true;
      allow create: if request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 10
        && request.resource.data.name is string
        && request.resource.data.role is string;
      allow update, delete: if false;
    }

    // ----- Users (roles) ----------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isModerator());
      allow create, update, delete: if isModerator();
    }

    // ----- R&S Jobs (vagas) -------------------------------------------------
    match /jobs/{id} {
      allow read: if true;
      allow create, update, delete: if isModerator();
    }

    // ----- R&S Candidates ---------------------------------------------------
    match /candidates/{id} {
      // Leitura permitida para usuários logados ou acesso à rota pública do gestor
      allow read: if true; 
      allow create, update, delete: if isModerator();

      // Subcoleção de Feedback dos Gestores
      match /gestor_feedback/{gestorUid} {
        allow read: if true;
        // Permite salvar tanto com texto quanto apenas selecionando o status (Aprovado/Negado/Espera)
        allow create, update: if true; 
        allow delete: if isModerator();
      }
    }

    // ----- DP Employees -----------------------------------------------------
    match /employees/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isModerator();
    }
  }
}
