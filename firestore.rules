rules_version = '2';

// ============================================================================
// VENDE-C Platform — Firestore Security Rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Approved moderators (RH). Update this list to add/remove RH access.
    function isModerator() {
      return request.auth != null
        && request.auth.token.email in [
          'vinicius.silva@vende-c.com',
          'lucas.zan@vende-c.com'
        ];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ----- Newsletters (RH News) --------------------------------------------
    match /newsletters/{id} {
      allow read: if true;
      allow create, update, delete: if isModerator();
    }

    // ----- Evaluations (RH News) --------------------------------------------
    match /evaluations/{id} {
      allow read: if true;
      allow create: if request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 10
        && request.resource.data.name is string
        && request.resource.data.role is string;
      allow update, delete: if false;
    }

    // ----- Users (roles) ----------------------------------------------------
    // Each signed-in user may read their own role doc. Only moderators can
    // create/update role docs (to promote gestores). The RH allowlist above
    // is applied client-side as an override, so moderators don't need a doc.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isModerator());
      allow create, update, delete: if isModerator();
    }

    // ----- R&S Candidates ---------------------------------------------------
    // Any signed-in user (RH or Gestor) may read candidates. Only moderators
    // may create/edit/delete the RH-owned data on the candidate document.
    match /candidates/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isModerator();

      // Gestor feedback: each gestor writes their own doc keyed by their uid.
      // Moderators can read/write any feedback. Everyone signed-in can read.
      match /gestor_feedback/{gestorUid} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && (request.auth.uid == gestorUid || isModerator())
          && request.resource.data.feedback is string
          && request.resource.data.feedback.size() <= 4000;
        allow delete: if isModerator() || request.auth.uid == gestorUid;
      }
    }

    // ----- DP Employees -----------------------------------------------------
    // Signed-in users may read the employee roster; only moderators (RH/DP)
    // may create, update or remove employee records.
    match /employees/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isModerator();
    }
  }
}
